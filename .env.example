# Copy to .env and fill in what you want. .env is git-ignored: it is the right
# place for an API key, because a key in a committed file is a leaked key.
#
# Nothing here is required. With an empty .env the product runs exactly as
# before: fully local, nothing leaving the machine.

# ---------------------------------------------------------------------------
# Narration for the Assistant and report prose
# ---------------------------------------------------------------------------
# Three switches, all of which must be in your favour:
#
#   1. MPLAB_ALLOW_EXTERNAL_AI=true  - the operator's master switch.
#   2. All three LLM_* values below    - a reachable, configured endpoint.
#   3. Per-project consent             - in Project Settings, per project.
#
# Even with all three set, only redacted and aggregated findings are sent.
# Packet bytes, capture files and key logs are never part of what is sent.

MPLAB_ALLOW_EXTERNAL_AI=false
MPLAB_LLM_PROVIDER=auto

# --- Hosted endpoint (anything that speaks POST {base}/chat/completions) ----
# OpenRouter:
#   key    https://openrouter.ai/keys
#   base   https://openrouter.ai/api/v1
#   model  a free model id, e.g. meta-llama/llama-3.3-8b-instruct:free
#
# A self-hosted vLLM/LM Studio works with the same three values, which keeps the
# text on the machine if you prefer that.
MPLAB_LLM_BASE_URL=
MPLAB_LLM_API_KEY=
MPLAB_LLM_MODEL=

# --- Local Ollama (the "ai" compose profile) --------------------------------
# docker compose --profile ai up -d
# Leave the three values above empty and this path is used instead.
MPLAB_OLLAMA_URL=http://127.0.0.1:11434
MPLAB_OLLAMA_MODEL=qwen2.5:7b-instruct