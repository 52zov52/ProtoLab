# Madrigal Protocol Lab - example configuration
#
# Every value here is a PLACEHOLDER or a safe default. This file contains no
# real secrets and must never be edited to hold one: the application refuses to
# start with obviously broken values rather than guessing.
#
# Copy to .env only if you need to override a default. In the default Local
# Secure profile you do not need this file at all - the application runs
# offline with no configuration.

# --- Run mode -------------------------------------------------------------
# local_secure : loopback only, no accounts, offline. This is the default and
#                the only mode verified by the automated tests.
# team_remote  : NOT a turnkey multi-user mode. It requires authentication,
#                authorisation, CSRF protection and TLS termination that this
#                build does not provide - see docs/SECURITY.md before enabling.
MPLAB_MODE=local_secure

# Bind address. In local_secure mode only loopback values are meaningful.
# Do not set 0.0.0.0: it exposes an unauthenticated analysis API to the network.
MPLAB_HOST=127.0.0.1
MPLAB_PORT=8010

# Interactive API docs at /api/docs. Convenient locally, so it is on in
# local_secure mode; turn off if you do not want it.
MPLAB_DEBUG=false

# --- Network policy -------------------------------------------------------
# Requests whose Host header is not on this list are rejected. This is the
# control that defeats DNS-rebinding attacks against a localhost service, so do
# not set a wildcard.
MPLAB_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Browser origins permitted to call the API. A state-changing request from any
# other Origin is refused. Keep this to the exact frontend origin.
MPLAB_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Storage --------------------------------------------------------------
# Where the SQLite database, imported captures and exports live. Point this at a
# dedicated directory; it is created on first run with owner-only permissions.
MPLAB_DATA_DIR=data

# PostgreSQL is NOT used. The metadata store is SQLite (see docs/ARCHITECTURE.md).

# --- Limits ---------------------------------------------------------------
# Ceilings on untrusted input and expensive work. Exceeding one produces an
# explicit error; data is never silently truncated.
MPLAB_MAX_UPLOAD_BYTES=104857600
MPLAB_MAX_CAPTURE_BYTES=104857600
MPLAB_MAX_PROJECT_FILES=500
MPLAB_MAX_JSON_BODY_BYTES=2097152
MPLAB_MAX_PACKETS_PER_CAPTURE=250000
MPLAB_MAX_TCP_SESSIONS_PER_CAPTURE=1000
MPLAB_MAX_CONCURRENT_JOBS=4
MPLAB_RATE_LIMIT_REQUESTS=300
MPLAB_RATE_LIMIT_WINDOW_SECONDS=60

# --- Project archives (.mplab) -------------------------------------------
# Archives are untrusted input. These bound a zip bomb or a hostile archive.
MPLAB_MAX_ARCHIVE_ENTRIES=20000
MPLAB_MAX_ARCHIVE_ENTRY_BYTES=268435456
MPLAB_MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
MPLAB_MAX_ARCHIVE_COMPRESSION_RATIO=200
MPLAB_MAX_ARCHIVE_DEPTH=12

# --- External AI (OFF by default) -----------------------------------------
# Nothing leaves this machine unless this is explicitly enabled. Even when on,
# only aggregated redacted statistics are sent - never capture bytes, TLS key
# logs or secrets. Point this at a local Ollama if you enable it.
MPLAB_ALLOW_EXTERNAL_AI=false
MPLAB_OLLAMA_URL=http://127.0.0.1:11434
MPLAB_OLLAMA_MODEL=qwen2.5:7b-instruct
MPLAB_MAX_AI_CONTEXT_CHARS=24000

# To run the optional local model with Docker instead of a host install:
#   docker compose --profile ai up
# Then set MPLAB_ALLOW_EXTERNAL_AI=true and point the backend at the service:
#   MPLAB_OLLAMA_URL=http://madrigal-ollama:11434
# The model is still never used unless the individual project also records
# consent ("Allow external AI for this project" in Project Settings).

# --- Frontend -------------------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8010

# --- Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Log lines are passed through a redaction
# filter; payload bytes, tokens and key-log material never reach the log.
MPLAB_LOG_LEVEL=INFO